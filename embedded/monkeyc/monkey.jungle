# Connect IQ build configuration for the Liftosaur watch app.
# Build:  monkeyc -d venu2 -f monkey.jungle -o bin/Liftosaur.prg -y developer_key.der
#
# typecheck levels: 0=off, 1=gradual, 2=informative, 3=strict.
# SDK samples build with the default (gradual); strict flags enums/constants
# that are otherwise valid, so we stay at gradual for the watch app.

project.manifest = manifest.xml
typecheck = 1
optimization = 0
sourcePath = source
resourcePath = resources
